/* =========================================================
   4. 文字解析
   ========================================================= */
const CODE_RE = /^[A-Z]{2,4}\d{3}[A-Z]?[.,·]\d{3}$/;
function normCodeTok(t) {
  return String(t || '').toUpperCase().replace(/[^A-Z0-9.,·]/g, '').replace(/[·]/g, '.');
}
function isCode(t) { return CODE_RE.test(normCodeTok(t)); }

function dayIndexOf(tok) {
  const t = String(tok || '').toLowerCase().replace(/[^a-z]/g, '');
  if (t.length < 3) return null;
  const map = { mon: 0, tue: 1, wed: 2, thu: 3, fri: 4, sat: 5, sun: 6 };
  for (const k in map) if (t.startsWith(k)) return map[k];
  return null;
}
function parseTimeTok(tok) {
  const m = /(\d{1,2})\s*[:.．]\s*(\d{2})\s*(am|pm|a\.m\.|p\.m\.)?/i.exec(String(tok || ''));
  if (!m) return null;
  let h = +m[1], mi = +m[2];
  const ap = (m[3] || '').toLowerCase().replace(/\./g, '');
  if (ap === 'pm' && h < 12) h += 12;
  if (ap === 'am' && h === 12) h = 0;
  if (!ap && h <= 7) h += 12;
  if (h > 23 || mi > 59) return null;
  return h * 60 + mi;
}
const ROOM_RE = /^[A-Z]{0,4}\d{1,4}[A-Z]?$/i;
const LECT_RE = /^[A-Z][A-Z'’\-]{1,},\S*$/;

function clusterLines(words) {
  if (!words.length) return [];
  const hs = words.map(w => w.h || 10).sort((a, b) => a - b);
  const medH = hs[Math.floor(hs.length / 2)] || 10;
  const tol = Math.max(6, medH * 0.65);
  const sorted = words.slice().sort((a, b) => (a.y + (a.h || 10) / 2) - (b.y + (b.h || 10) / 2));
  const lines = [];
  for (const w of sorted) {
    const cy = w.y + (w.h || 10) / 2;
    const last = lines[lines.length - 1];
    if (last && Math.abs(cy - last.cy) < tol) {
      last.words.push(w); last.n++; last.cy += (cy - last.cy) / last.n;
    } else lines.push({ cy, n: 1, words: [w] });
  }
  lines.forEach(l => l.words.sort((a, b) => a.x - b.x));
  return lines;
}

function tryAppendTitle(out, line) {
  if (!out.length) return;
  const toks = line.words.map(w => w.text);
  const txt = toks.join(' ').trim();
  if (!txt || txt.length > 60) return;
  if (/\d{1,2}\s*[:.]\s*\d{2}/.test(txt)) return;
  if (toks.some(t => dayIndexOf(t) !== null)) return;
  if (toks.some(isCode)) return;
  if (/(course|title|lecturer|day|start|end|room|exam|released|venue)/i.test(txt)) return;
  const prev = out[out.length - 1];
  if (typeof prev._tx0 === 'number' && line.words[0].x < prev._tx0 - 5) return;
  if (typeof prev._tx1 === 'number' && prev._tx1 && line.words[0].x > prev._tx1 + 5) return;
  if (prev.title && prev.title.toUpperCase().includes(txt.toUpperCase())) return;
  prev.title = (prev.title + ' ' + txt).replace(/\s+/g, ' ').trim();
}

function parseListLines(lines) {
  const out = [];
  for (const line of lines) {
    const toks = line.words.map(w => w.text);
    const ci = toks.findIndex(isCode);
    if (ci < 0) { tryAppendTitle(out, line); continue; }

    const code = normCodeTok(toks[ci]).replace(/[^A-Z0-9.]/g, '');
    let dayIdx = -1;
    for (let i = ci + 1; i < toks.length; i++) {
      if (dayIndexOf(toks[i]) !== null) { dayIdx = i; break; }
    }
    if (dayIdx < 0) continue;

    let lecturer = '', titleEnd = dayIdx;
    for (let i = dayIdx - 1; i > ci; i--) {
      if (LECT_RE.test(toks[i])) { lecturer = toks[i].replace(/,$/, ''); titleEnd = i; break; }
    }
    const title = toks.slice(ci + 1, titleEnd).join(' ')
      .replace(/\s+/g, ' ').replace(/\s*[-–—]\s*/g, ' - ').trim();

    const times = [];
    for (let i = dayIdx + 1; i < toks.length; i++) {
      const m = parseTimeTok(toks[i]);
      if (m !== null) times.push({ m, i });
    }
    if (times.length < 2) continue;
    let start = times[0].m, end = times[1].m;
    if (end <= start && end + 720 <= 23 * 60) end += 720;

    let room = '';
    for (let i = times[1].i + 1; i < toks.length; i++) {
      const t = toks[i].replace(/[,;:]/g, '');
      if (/^NOT$/i.test(t) || /^RELEASED$/i.test(t)) continue;
      if (ROOM_RE.test(t)) { room = t; break; }
      if (/^[A-Z]{2,4}$/.test(t) && /^\d{2,4}$/.test(toks[i + 1] || '')) { room = t + toks[i + 1]; break; }
    }

    const c = mkCourse({ code, title, lecturer, room, day: dayIndexOf(toks[dayIdx]), start, end });
    c._tx0 = line.words[ci].x;
    c._tx1 = line.words[titleEnd - 1] ? line.words[titleEnd - 1].x : line.words[dayIdx].x;
    out.push(c);
  }
  return out;
}

function parseGridWords(words) {
  const heads = [];
  for (const w of words) {
    const d = dayIndexOf(w.text);
    if (d === null) continue;
    if (String(w.text).replace(/[^A-Za-z]/g, '').length < 3) continue;
    if (!heads.find(h => h.d === d)) heads.push({ d, x: w.x + (w.w || 0) / 2, y: w.y });
  }
  if (heads.length < 3) return [];
  const colOf = x => {
    let best = 0, bd = Infinity;
    heads.forEach(h => { const dd = Math.abs(x - h.x); if (dd < bd) { bd = dd; best = h.d; } });
    return best;
  };

  const bands = [];
  for (const line of clusterLines(words)) {
    const txt = line.words.map(w => w.text).join(' ');
    const ms = [...txt.matchAll(/(\d{1,2}\s*[:.]\s*\d{2}\s*(?:am|pm)?)/gi)];
    if (ms.length >= 2) {
      const st = parseTimeTok(ms[0][1]), en = parseTimeTok(ms[1][1]);
      if (st !== null && en !== null && en > st) bands.push({ st, en, y: line.cy, x: line.words[0].x });
    }
  }
  if (!bands.length) return [];
  bands.sort((a, b) => a.y - b.y);
  const labelRight = Math.max.apply(null, bands.map(b => b.x));

  const cells = new Map();
  for (const w of words) {
    if (w.x <= labelRight + 10) continue;
    let band = bands[0];
    for (const b of bands) if (w.y + (w.h || 10) / 2 >= b.y - 12) band = b;
    const key = colOf(w.x) + '|' + bands.indexOf(band);
    if (!cells.has(key)) cells.set(key, { day: colOf(w.x), band, words: [] });
    cells.get(key).words.push(w);
  }

  const out = [], seen = new Set();
  for (const c of cells.values()) {
    const toks = c.words.sort((a, b) => a.y - b.y || a.x - b.x).map(w => w.text);
    const ci = toks.findIndex(isCode);
    if (ci < 0) continue;
    const code = normCodeTok(toks[ci]).replace(/[^A-Z0-9.]/g, '');
    const key = code + c.day + c.band.st;
    if (seen.has(key)) continue;
    seen.add(key);
    let lecturer = '', room = '';
    for (let i = 0; i < toks.length; i++) {
      if (LECT_RE.test(toks[i])) lecturer = toks[i].replace(/,$/, '');
      if (/^venue$/i.test(toks[i]) && toks[i + 1]) room = toks[i + 1];
    }
    if (!room) for (const t of toks) if (ROOM_RE.test(t) && !/^\d{3}\.\d{3}$/.test(t)) { room = t; break; }
    out.push(mkCourse({ code, title: code, lecturer, room, day: c.day, start: c.band.st, end: c.band.en }));
  }
  return out;
}

function parsePlainText(text) {
  const out = [];
  const DAY_RE = /\b(mon(?:day)?|tue(?:s(?:day)?)?|wed(?:nesday)?|thu(?:r(?:s(?:day)?)?)?|fri(?:day)?|sat(?:urday)?|sun(?:day)?)\b/i;
  for (const raw of String(text || '').split(/\r?\n/)) {
    const line = raw.replace(/\t/g, ' ').replace(/\s+/g, ' ').trim();
    if (!line) continue;
    const first = line.split(' ')[0];
    if (!isCode(first)) continue;
    const code = normCodeTok(first).replace(/[^A-Z0-9.]/g, '');
    const dm = DAY_RE.exec(line);
    if (!dm) continue;
    const day = dayIndexOf(dm[1]);
    const rest = line.slice(dm.index + dm[0].length);
    const tm = [...rest.matchAll(/(\d{1,2}\s*[:.]\s*\d{2}\s*(?:am|pm)?)/gi)];
    if (tm.length < 2) continue;
    const start = parseTimeTok(tm[0][1]);
    let end = parseTimeTok(tm[1][1]);
    if (start === null || end === null) continue;
    if (end <= start && end + 720 <= 23 * 60) end += 720;

    const head = line.slice(0, dm.index);
    const lm = /([A-Z]{2,}[A-Z'’\-]*,\s*[A-Z]{1,4})/.exec(head);
    const lecturer = lm ? lm[1].replace(/\s/g, '') : '';
    let title = head.slice(first.length);
    if (lm) { const ix = title.indexOf(lm[1]); if (ix >= 0) title = title.slice(0, ix); }
    title = title.replace(/\s+/g, ' ').replace(/\s*[-–—]\s*/g, ' - ').trim();

    const after = rest.slice(tm[1].index + tm[1][0].length);
    const rm = /\b([A-Z]{0,4}\d{1,4}[A-Z]?)\b/.exec(after);
    out.push(mkCourse({ code, title, lecturer, room: rm ? rm[1] : '', day, start, end }));
  }
  return out;
}

