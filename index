const HK_BUILTIN = {
  2026: [
    ['2026-01-01', '一月一日'],
    ['2026-02-17', '農曆年初一'],
    ['2026-02-18', '農曆年初二'],
    ['2026-02-19', '農曆年初三'],
    ['2026-04-03', '耶穌受難節'],
    ['2026-04-04', '耶穌受難節翌日'],
    ['2026-04-06', '復活節星期一'],
    ['2026-04-07', '清明節翌日'],
    ['2026-05-01', '勞動節'],
    ['2026-05-25', '佛誕'],
    ['2026-06-19', '端午節'],
    ['2026-07-01', '香港特別行政區成立紀念日'],
    ['2026-09-26', '中秋節翌日'],
    ['2026-10-01', '國慶日'],
    ['2026-10-19', '重陽節'],
    ['2026-12-25', '聖誕節'],
    ['2026-12-26', '聖誕節後第一個周日']
  ]
};

function builtinList(year) {
  const raw = HK_BUILTIN[year];
  if (!raw) return null;
  return raw.map(pair => ({ date: pair[0], name: pair[1], off: true, src: 'builtin' }));
}

function semesterYears() {
  const a = anchorMonday() || state.semester.start;
  const b = state.semester.end;
  const pa = parseYMD(a), pb = parseYMD(b);
  if (!pa || !pb) return [];
  const ys = [];
  for (let y = pa.y; y <= pb.y; y++) ys.push(y);
  return ys;
}

function easterYmd(y) {
  const a = y % 19, b = Math.floor(y / 100), c = y % 100, d = Math.floor(b / 4), e = b % 4,
    f = Math.floor((b + 8) / 25), g = Math.floor((b - f + 1) / 3),
    h = (19 * a + b - d - g + 15) % 30, i = Math.floor(c / 4), k = c % 4,
    l = (32 + 2 * e + 2 * i - h - k) % 7, m = Math.floor((a + 11 * h + 22 * l) / 451),
    mo = Math.floor((h + l - 7 * m + 114) / 31), da = ((h + l - 7 * m + 114) % 31) + 1;
  return `${y}-${pad2(mo)}-${pad2(da)}`;
}

function fixedHK(y) {
  const e = easterYmd(y);
  return [
    { date: `${y}-01-01`, name: '一月一日' },
    { date: addDaysYmd(e, -2), name: '耶穌受難節' },
    { date: addDaysYmd(e, -1), name: '耶穌受難節翌日' },
    { date: e, name: '復活節星期一' },
    { date: `${y}-05-01`, name: '勞動節' },
    { date: `${y}-07-01`, name: '香港特別行政區成立紀念日' },
    { date: `${y}-10-01`, name: '國慶日' },
    { date: `${y}-12-25`, name: '聖誕節' },
    { date: `${y}-12-26`, name: '聖誕節後第一個周日' }
  ].map(h => ({ date: h.date, name: h.name, off: true, src: 'fixed' }));
}

function normalizeHolidayJSON(json) {
  let arr = json;
  if (arr && !Array.isArray(arr) && Array.isArray(arr.data)) arr = arr.data;
  if (!Array.isArray(arr)) return [];
  return arr.map(h => ({
    date: h.date || h.start || h.day || '',
    name: h.localName || h.name || h.summary || h.title || '',
    off: true,
    src: 'hk'
  })).filter(h => /^\d{4}-\d{2}-\d{2}$/.test(h.date));
}

async function fetchYearHolidays(year, force) {
  const ck = 'holiHK.v3.' + year;
  if (!force) {
    try {
      const c = localStorage.getItem(ck);
      if (c) {
        const p = JSON.parse(c);
        if (Array.isArray(p) && p.length) return { list: p, src: 'cache' };
      }
    } catch (e) {}
  }

  const api = 'https://date.nager.at/api/v3/PublicHolidays/' + year + '/HK';
  const urls = [
    api,
    'https://api.allorigins.win/raw?url=' + encodeURIComponent(api),
    'https://api.codetabs.com/v1/proxy?quest=' + encodeURIComponent(api)
  ];

  for (const u of urls) {
    try {
      const res = await fetchTimeout(u, 7000);
      if (!res.ok) continue;
      const json = await res.json();
      const list = normalizeHolidayJSON(json);
      if (list.length) {
        try { localStorage.setItem(ck, JSON.stringify(list)); } catch (e) {}
        return { list, src: 'api' };
      }
    } catch (e) { /* 換下一個來源 */ }
  }

  const bl = builtinList(year);
  if (bl) return { list: bl, src: 'builtin' };
  return { list: fixedHK(year), src: 'fixed' };
}

function mergeHoliday(h) {
  if (!parseYMD(h.date)) return;
  const ex = state.holidays.find(x => x.date === h.date);
  if (ex) { if (!ex.name) ex.name = h.name; return; }
  state.holidays.push({ date: h.date, name: h.name || '', off: true, src: h.src || 'hk' });
}

function replaceYearHolidays(year, list) {
  const ys = String(year);
  state.holidays = state.holidays.filter(h => {
    const sameYear = String(h.date).slice(0, 4) === ys;
    return !(sameYear && h.src !== 'custom');
  });
  (list || []).forEach(mergeHoliday);
}

let holiBusy = false;

function holidayMessage(used, years) {
  const label = { api: '已從線上資料庫取得', cache: '使用上次快取', builtin: '使用內建官方清單', fixed: '只有固定假期' };
  const parts = years.map(y => `${y}：${label[used[y]] || '已載入'}`);
  const degraded = years.some(y => used[y] === 'builtin' || used[y] === 'fixed');
  let msg = parts.join('　·　');
  if (years.some(y => used[y] === 'fixed')) {
    msg += '。農曆假期（新年、佛誕、端午、中秋、重陽）請自行補上，或到政府網站查看後新增。';
  } else if (degraded) {
    msg += '。內建資料請自行核對一次；不適用的日子取消勾選即可。';
  } else {
    msg += '。';
  }
  return msg;
}

async function loadHKHolidays(force) {
  if (holiBusy) return;
  const years = semesterYears();
  if (!years.length) { setText('#holiStatus', '請先設定學期開始與結束日期。'); return; }
  holiBusy = true;
  setText('#holiStatus', '正在載入香港公眾假期…');

  const used = {};
  for (const y of years) {
    let r;
    try {
      r = await fetchYearHolidays(y, force);
    } catch (e) {
      r = { list: builtinList(y) || fixedHK(y), src: builtinList(y) ? 'builtin' : 'fixed' };
    }
    replaceYearHolidays(y, r.list);
    used[y] = r.src;
  }

  holiBusy = false;
  renderHolidays(); renderSemesterInfo(); renderOutput(); save();
  setText('#holiStatus', holidayMessage(used, years));
}

function renderHolidays() {
  const a = anchorMonday() || state.semester.start;
  const end = state.semester.end;
  let list = (state.holidays || []).slice().filter(h => !!parseYMD(h.date));
  if (a && end) list = list.filter(h => h.date >= addDaysYmd(a, -3) && h.date <= addDaysYmd(end, 3));
  list.sort((x, y) => x.date.localeCompare(y.date));

  const box = $('#holiChips');
  if (!box) return;
  if (!list.length) {
    box.innerHTML = '<span class="hint">尚未載入假期。按「重新載入公眾假期」，或手動新增停課日。</span>';
    return;
  }
  box.innerHTML = list.map(h => `
    <label class="chip ${h.off ? 'on' : 'off'}">
      <input type="checkbox" ${h.off ? 'checked' : ''} data-toggle="${h.date}">
      <b>${h.date.slice(5).replace('-', '/')}</b>
      <span>${esc(h.name || '停課')}</span>
      ${h.src === 'custom' ? `<span class="x" data-del="${h.date}">×</span>` : ''}
    </label>`).join('');

  box.querySelectorAll('[data-toggle]').forEach(cb => {
    cb.addEventListener('change', () => {
      const h = state.holidays.find(x => x.date === cb.getAttribute('data-toggle'));
      if (h) h.off = cb.checked;
      renderHolidays(); renderSemesterInfo(); renderOutput(); save();
    });
  });
  box.querySelectorAll('[data-del]').forEach(x => {
    x.addEventListener('click', ev => {
      ev.preventDefault(); ev.stopPropagation();
      const d = x.getAttribute('data-del');
      state.holidays = state.holidays.filter(h => h.date !== d);
      renderHolidays(); renderSemesterInfo(); renderOutput(); save();
    });
  });
}

/* =========================================================
   8. 時間表渲染
   ========================================================= */
const DAY_START = 8 * 60;
const DAY_END = 23 * 60;
let PPM = 1.2;

function renderHead() {
  const h = $('#gridHead');
  if (!h) return;
  h.innerHTML = '<div class="hcell time">時間</div>' +
    DAY_ZH.map((d, i) => `<div class="hcell">${d}<br><span style="font-size:9.5px;font-weight:400">${DAY_ABBR[i]}</span></div>`).join('');
}

function renderGrid() {
  const body = $('#gridBody');
  if (!body) return;
  const H = (DAY_END - DAY_START) * PPM;
  const hourPx = 60 * PPM;

  let html = '<div class="taxis" style="height:' + H + 'px">';
  for (let hh = 8; hh <= 22; hh++) html += `<span style="top:${(hh * 60 - DAY_START) * PPM}px">${pad2(hh)}:00</span>`;
  html += '</div>';

  for (let d = 0; d < 7; d++) {
    const list = state.courses.filter(c => blockDay(c) === d).sort((a, b) => a.start - b.start);
    const cols = [];
    list.forEach(c => {
      let placed = false;
      for (let i = 0; i < cols.length; i++) {
        if (cols[i].every(o => c.start >= o.end || c.end <= o.start)) {
          cols[i].push(c); c._col = i; placed = true; break;
        }
      }
      if (!placed) { cols.push([c]); c._col = cols.length - 1; }
    });
    const n = Math.max(1, cols.length);

    html += `<div class="daycol" data-day="${d}" style="height:${H}px;background-image:repeating-linear-gradient(to bottom,#f1f1f4 0 1px,transparent 1px ${hourPx}px)">`;
    for (const c of list) {
      const top = Math.max(0, (c.start - DAY_START) * PPM);
      const hgt = Math.max(18, (Math.min(c.end, DAY_END) - c.start) * PPM);
      const w = 100 / n, left = c._col * w;
      const wn = weekNoOf(firstDateOf(c));
      const isLate = c.kind !== 'event' && wn > 1;
      const cls = 'blk'
        + (c.kind === 'event' ? ' one' : (c.freq === 'biweekly' ? ' bi' : ''))
        + (isLate ? ' late' : '')
        + (state.selected === c.id ? ' sel' : '');
      const label = c.code || c.title || '未命名';
      let freqTag;
      if (c.kind === 'event') {
        freqTag = '單次 ' + (c.date ? c.date.slice(5).replace('-', '/') : '未定');
      } else if (wn > 0) {
        freqTag = (c.freq === 'biweekly' ? '兩週一次' : '每週') + '·第' + wn + '週起';
      } else {
        freqTag = c.freq === 'biweekly' ? '兩週一次' : '每週';
      }
      html += `<div class="${cls}" data-id="${c.id}"
        style="top:${top}px;height:${hgt}px;left:calc(${left}% + 2px);width:calc(${w}% - 4px)">
        <b>${esc(label)}</b>
        <span>${fmtMin(c.start)}–${fmtMin(c.end)} · ${freqTag}</span>
        ${hgt > 44 ? `<span>${esc(c.title && c.title !== c.code ? c.title : '')}</span>` : ''}
        ${hgt > 60 ? `<span>${esc(c.room ? 'Room ' + c.room : '')}</span>` : ''}
      </div>`;
    }
    html += '</div>';
  }
  body.innerHTML = html;
  bindBlocks();
  setText('#cntBadge', state.courses.length + ' 項');
}

function renderPrintSub() {
  const a = anchorMonday();
  const w = weeksCount();
  setText('#printSub', (a ? `${a} 起 · 共 ${w} 週 · ` : '') + `列印於 ${todayYmd()}`);
}

/* =========================================================
   9. 拖曳
   ========================================================= */
let drag = null;

function bindBlocks() {
  $$('.blk').forEach(el => {
    el.addEventListener('pointerdown', e => {
      if (e.button !== undefined && e.button !== 0) return;
      const c = state.courses.find(x => x.id === el.getAttribute('data-id'));
      if (!c) return;
      const colEl = el.closest('.daycol');
      const colW = colEl ? colEl.getBoundingClientRect().width : 100;
      drag = {
        id: c.id, el, colW, startX: e.clientX, startY: e.clientY,
        origStart: c.start, origEnd: c.end, origDay: blockDay(c), moved: false
      };
      try { el.setPointerCapture(e.pointerId); } catch (err) {}
      el.style.zIndex = 9;
      e.preventDefault();
    });

    el.addEventListener('pointermove', e => {
      if (!drag || drag.el !== el) return;
      const dy = e.clientY - drag.startY, dx = e.clientX - drag.startX;
      if (Math.abs(dy) > 4 || Math.abs(dx) > 4) drag.moved = true;
      if (!drag.moved) return;
      let dm = Math.round(dy / PPM / 5) * 5;
      dm = Math.max(DAY_START - drag.origStart, Math.min(DAY_END - drag.origEnd, dm));
      drag.newStart = drag.origStart + dm;
      drag.newEnd = drag.origEnd + dm;
      const dDay = Math.round(dx / Math.max(40, drag.colW));
      drag.newDay = Math.max(0, Math.min(6, drag.origDay + dDay));
      el.style.transform = `translate(${(drag.newDay - drag.origDay) * drag.colW}px, ${(drag.newStart - drag.origStart) * PPM}px)`;
    });

    const endDrag = () => {
      if (!drag || drag.el !== el) return;
      const c = state.courses.find(x => x.id === drag.id);
      if (c) {
        if (drag.moved && drag.newStart !== undefined) {
          c.start = drag.newStart;
          c.end = drag.newEnd;
          const delta = drag.newDay - drag.origDay;
          if (c.kind === 'event' && c.date) {
            c.date = addDaysYmd(c.date, delta);
          } else {
            c.day = drag.newDay;
            /* 有第一堂日期就跟著平移，保持「第幾週」不變 */
            if (parseYMD(c.firstDate)) c.firstDate = addDaysYmd(c.firstDate, delta);
          }
        }
        state.selected = c.id;
      }
      drag = null;
      renderAll(); save();
    };
    el.addEventListener('pointerup', endDrag);
    el.addEventListener('pointercancel', endDrag);
  });
}

/* =========================================================
   10. 編輯面板
