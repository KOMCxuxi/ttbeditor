  tessWorker = await Tesseract.createWorker('eng', 1, {
    logger: m => { if (m && m.status) setProgress(m.progress || 0, m.status); }
  });
  await tessWorker.setParameters({ tessedit_pageseg_mode: '6', preserve_interword_spaces: '1' });
  return tessWorker;
}

function wordsFromTSV(tsv) {
  const out = [];
  for (const line of String(tsv || '').split('\n')) {
    const cols = line.split('\t');
    if (cols.length < 12 || cols[0] !== '5') continue;
    const conf = parseFloat(cols[10]);
    const text = (cols[11] || '').trim();
    if (!text || isNaN(conf) || conf < 25) continue;
    const x = +cols[6], y = +cols[7], w = +cols[8], h = +cols[9];
    if (!isFinite(x) || !isFinite(y)) continue;
    out.push({ text, x, y, w, h });
  }
  return out;
}

async function ocrCanvas(canvas) {
  const w = await getWorker();
  setProgress(0.1, '辨識中…');
  const res = await w.recognize(canvas, {}, { text: true, tsv: true });
  const data = res && res.data ? res.data : res;
  let words = (data && data.tsv) ? wordsFromTSV(data.tsv) : [];
  if (!words.length && data && data.words) {
    words = data.words.filter(x => x.text && x.text.trim())
      .map(x => ({ text: x.text.trim(), x: x.bbox.x0, y: x.bbox.y0, w: x.bbox.x1 - x.bbox.x0, h: x.bbox.y1 - x.bbox.y0 }));
  }
  setProgress(1, '辨識完成');
  return words;
}

async function ensurePdfjs() {
  if (window.pdfjsLib) return;
  await loadScript([
    'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js',
    'https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.min.js'
  ]);
  if (!window.pdfjsLib) throw new Error('PDF 引擎載入失敗');
  window.pdfjsLib.GlobalWorkerOptions.workerSrc =
    'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
}

function expandPdfItem(it, pageH) {
  const str = String(it.str || '');
  if (!str.trim()) return [];
  const parts = str.trim().split(/\s+/);
  const total = Math.max(1, str.length);
  const cw = (it.width || parts.length * 6) / total;
  const out = [];
  let cursor = 0;
  for (const p of parts) {
    const idx = str.indexOf(p, cursor);
    const xx = (idx >= 0 ? idx : cursor) * cw;
    out.push({
      text: p, x: it.transform[4] + xx, y: pageH - it.transform[5],
      w: p.length * cw, h: Math.abs(it.height || it.transform[3] || 10)
    });
    cursor = (idx >= 0 ? idx : cursor) + p.length;
  }
  return out;
}

async function handleFile(file) {
  if (!file) return;
  showProg(true);
  const log = $('#progLog');
  if (log) log.textContent = '';
  logLine('讀取 ' + (file.name || '檔案') + ' …');
  try {
    const isPdf = file.type === 'application/pdf' || /\.pdf$/i.test(file.name || '');
    let words = [];
    if (isPdf) {
      await ensurePdfjs();
      const buf = await file.arrayBuffer();
      const pdf = await pdfjsLib.getDocument({ data: buf }).promise;
      logLine('PDF 共 ' + pdf.numPages + ' 頁');
      const collected = [];
      for (let p = 1; p <= Math.min(pdf.numPages, 3); p++) {
        const page = await pdf.getPage(p);
        const vp = page.getViewport({ scale: 1 });
        const tc = await page.getTextContent();
        for (const it of tc.items) {
          if (!it.str || !it.str.trim()) continue;
          collected.push.apply(collected, expandPdfItem(it, vp.height));
        }
      }
      if (collected.map(w => w.text).join('').length > 120) {
        logLine('偵測到 PDF 文字層 → 直接抽取文字（比 OCR 準）');
        words = collected;
      } else {
        logLine('PDF 沒有文字層（掃描檔）→ 改用 OCR');
        words = await ocrPdf(file);
      }
    } else {
      logLine('圖片前處理：放大 + 灰階 + 對比強化');
      words = await ocrCanvas(preprocess(await fileToCanvas(file)));
    }
    logLine('取得 ' + words.length + ' 個文字片段');
    finishParse(extractCourses(words));
  } catch (err) {
    console.error(err);
    logLine('❌ ' + (err && err.message ? err.message : String(err)));
    logLine('OCR 需要網路連線下載引擎。也可以先用「載入我的課表示例」，或「貼上文字版課表」。');
  }
}

async function ocrPdf(file) {
  const buf = await file.arrayBuffer();
  const pdf = await pdfjsLib.getDocument({ data: buf.slice(0) }).promise;
  const page = await pdf.getPage(1);
  const vp = page.getViewport({ scale: 2 });
  const c = document.createElement('canvas');
  c.width = Math.round(vp.width); c.height = Math.round(vp.height);
  await page.render({ canvasContext: c.getContext('2d'), viewport: vp }).promise;
  return ocrCanvas(preprocess(c));
}

function extractCourses(words) {
  if (!words || !words.length) return [];
  const lines = clusterLines(words);
  let list = parseListLines(lines);
  if (list.length) {
    logLine('以「List 檢視」模式解析：找到 ' + list.length + ' 筆');
  } else {
    logLine('List 模式沒有結果 → 嘗試「Timetable 格子」模式');
    list = parseGridWords(words);
  }
  return list.map(c => { delete c._tx0; delete c._tx1; return c; });
}

function finishParse(courses) {
  const valid = (courses || []).filter(c => c && (c.title || c.code));
  const seen = new Set(), dedup = [];
  for (const c of valid) {
    const k = c.code + '|' + c.day + '|' + c.start;
    if (seen.has(k)) continue;
    seen.add(k); dedup.push(c);
  }
  if (!dedup.length) {
    logLine('⚠️ 沒有辨識出任何課程。建議改用「貼上文字版課表」，或手動新增。');
    return;
  }
  dedup.forEach(c => state.courses.push(c));
  renderAll(); save();
  logLine('✅ 匯入 ' + dedup.length + ' 門課，請在下方核對');
  const s2 = $('#step2');
  if (s2) s2.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

/* =========================================================
   6. 日期推算
   ========================================================= */
function anchorMonday() { return state.semester.start ? mondayOfYmd(state.semester.start) : ''; }

function weeksCount() {
  const a = anchorMonday();
  if (!a || !state.semester.end) return 0;
  const d = daysBetweenYmd(a, state.semester.end);
  return d < 0 ? 0 : Math.floor(d / 7) + 1;
}
function holidayOffSet() {
  const s = new Set();
  (state.holidays || []).forEach(h => { if (h.off && h.date) s.add(h.date); });
  return s;
}

/* 這門課「第一堂」的日期：有設定就用設定值，否則用學期第一週的該星期 */
function firstDateOf(c) {
  if (c.kind === 'event') return c.date || '';
  if (parseYMD(c.firstDate)) return c.firstDate;
  const a = anchorMonday();
  if (!a) return '';
  const off = (c.freq === 'biweekly' && c.biweek === 2) ? 7 : 0;
  return addDaysYmd(a, c.day + off);
}

/* 該日期是學期第幾週（1 起算；無法計算回傳 0） */
function weekNoOf(dateStr) {
  const a = anchorMonday();
  if (!a || !parseYMD(dateStr)) return 0;
  const d = daysBetweenYmd(a, dateStr);
  if (d < 0) return 0;
  return Math.floor(d / 7) + 1;
}

function blockDay(c) {
  if (c.kind === 'event' && c.date) {
    const d = dowMonOfYmd(c.date);
    return (d >= 0 && d <= 6) ? d : c.day;
  }
  if (parseYMD(c.firstDate)) return dowMonOfYmd(c.firstDate);
  return c.day;
}

function courseDates(c, anchor, endYmd) {
  if (!anchor || !endYmd) return [];
  if (c.kind === 'event') {
    if (!c.date) return [];
    return (c.date >= anchor && c.date <= endYmd) ? [c.date] : [];
  }
  const start = firstDateOf(c);
  if (!parseYMD(start)) return [];
  const out = [];
  const step = c.freq === 'biweekly' ? 14 : 7;
  let cur = start;
  let guard = 0;
  while (cur && cur <= endYmd && guard++ < 200) {
    out.push(cur);
    cur = addDaysYmd(cur, step);
  }
  return out;
}

function effectiveDates(c) {
  const anchor = anchorMonday();
  const end = state.semester.end;
  if (!anchor || !end) return { all: [], excl: [], kept: [] };
  const all = courseDates(c, anchor, end);
  let excl = [];
  if (c.kind !== 'event') {
    const off = holidayOffSet();
    const extra = new Set(c.skip || []);
    excl = all.filter(d => off.has(d) || extra.has(d));
  }
  const exclSet = new Set(excl);
  let kept = all.filter(d => !exclSet.has(d));
  if (state.settings.futureOnly) {
    const t = todayYmd();
    kept = kept.filter(d => d >= t);
  }
  return { all, excl, kept };
}

