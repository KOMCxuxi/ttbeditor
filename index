/* =========================================================
   12. ICS
   ========================================================= */
const TZ_INFO = {
  'Asia/Hong_Kong': ['+0800', 'HKT'],
  'Asia/Taipei': ['+0800', 'CST'],
  'Asia/Macau': ['+0800', 'CST'],
  'Asia/Shanghai': ['+0800', 'CST'],
  'Asia/Singapore': ['+0800', 'SGT'],
  'Asia/Tokyo': ['+0900', 'JST'],
  'Asia/Seoul': ['+0900', 'KST'],
  'Etc/UTC': ['+0000', 'UTC']
};

function icsEsc(t) {
  return String(t ?? '').replace(/\\/g, '\\\\').replace(/;/g, '\\;')
    .replace(/,/g, '\\,').replace(/\r?\n/g, '\\n');
}
function foldLine(line) {
  const enc = new TextEncoder();
  let out = '', cur = '', len = 0;
  for (const ch of line) {
    const l = enc.encode(ch).length;
    if (len + l > 73) { out += cur + '\r\n '; cur = ''; len = 0; }
    cur += ch; len += l;
  }
  return out + cur;
}
function icsLocalStamp(ymdStr, minutes) {
  return `${ymdStr.replace(/-/g, '')}T${pad2(Math.floor(minutes / 60))}${pad2(minutes % 60)}00`;
}
function icsUtcNow() {
  const d = new Date();
  return `${d.getUTCFullYear()}${pad2(d.getUTCMonth() + 1)}${pad2(d.getUTCDate())}T` +
    `${pad2(d.getUTCHours())}${pad2(d.getUTCMinutes())}${pad2(d.getUTCSeconds())}Z`;
}
function triggerStr(min) {
  const h = Math.floor(min / 60), m = min % 60;
  if (h && m) return `-PT${h}H${m}M`;
  if (h) return `-PT${h}H`;
  return `-PT${m}M`;
}
function uidOf(c) {
  const slug = String(c.code || c.title || 'item').replace(/[^A-Za-z0-9]/g, '') || 'item';
  const tail = c.kind === 'event'
    ? (c.date || 'nodate').replace(/-/g, '')
    : (blockDay(c) + '-' + c.start);
  return `t2c-${slug}-${tail}@timetable2cal`;
}

function buildICS() {
  const anchor = anchorMonday();
  const endYmd = state.semester.end;
  const tz = (state.semester.tz in TZ_INFO) ? state.semester.tz : 'Asia/Hong_Kong';
  const info = TZ_INFO[tz];
  const until = `${String(endYmd || '').replace(/-/g, '')}T235959Z`;
  const stamp = icsUtcNow();

  const L = [];
  L.push('BEGIN:VCALENDAR');
  L.push('VERSION:2.0');
  L.push('PRODID:-//Timetable2Cal//ZH-TW//EN');
  L.push('CALSCALE:GREGORIAN');
  L.push('METHOD:PUBLISH');
  L.push('X-WR-CALNAME:我的課表');
  L.push('X-WR-TIMEZONE:' + tz);
  L.push('BEGIN:VTIMEZONE');
  L.push('TZID:' + tz);
  L.push('X-LIC-LOCATION:' + tz);
  L.push('BEGIN:STANDARD');
  L.push('DTSTART:19700101T000000');
  L.push('TZOFFSETFROM:' + info[0]);
  L.push('TZOFFSETTO:' + info[0]);
  L.push('TZNAME:' + info[1]);
  L.push('END:STANDARD');
  L.push('END:VTIMEZONE');

  const skipped = [];
  let count = 0;

  for (const c of state.courses) {
    const eff = effectiveDates(c);
    if (!eff.kept.length) { skipped.push(c); continue; }
    const first = eff.kept[0];
    const fd = firstDateOf(c);
    const wn = weekNoOf(fd);

    const summary = [c.code, c.title].filter(Boolean).join(' ') || '課堂';
    const desc = [];
    if (c.lecturer) desc.push('Lecturer: ' + c.lecturer);
    if (c.room) desc.push('Room: ' + c.room);
    if (c.kind === 'event') {
      desc.push('單次行程');
    } else {
      desc.push(c.freq === 'biweekly' ? '頻率：兩週一次' : '頻率：每週一次');
      if (fd) desc.push('第一堂：' + fd + (wn >= 1 ? `（學期第 ${wn} 週）` : ''));
    }
    if (eff.excl.length) desc.push('已跳過：' + eff.excl.join(', '));

    const remind = c.remind === null ? state.settings.remindMin : c.remind;

    L.push('BEGIN:VEVENT');
    L.push('UID:' + uidOf(c));
    L.push('SEQUENCE:' + (state.exportSeq || 0));
    L.push('DTSTAMP:' + stamp);
    L.push('DTSTART;TZID=' + tz + ':' + icsLocalStamp(first, c.start));
    L.push('DTEND;TZID=' + tz + ':' + icsLocalStamp(first, c.end));

    if (c.kind !== 'event') {
      L.push('RRULE:' + (c.freq === 'biweekly'
        ? `FREQ=WEEKLY;INTERVAL=2;UNTIL=${until}`
        : `FREQ=WEEKLY;UNTIL=${until}`));
      const ex = eff.excl.filter(d => d >= first);
      if (ex.length) L.push('EXDATE;TZID=' + tz + ':' + ex.map(d => icsLocalStamp(d, c.start)).join(','));
    }

    L.push('SUMMARY:' + icsEsc(summary));
    if (c.room) L.push('LOCATION:' + icsEsc((c.kind === 'event' ? '' : 'Room ') + c.room));
    L.push('DESCRIPTION:' + icsEsc(desc.join('\n')));
    L.push('TRANSP:OPAQUE');

    if (remind > 0) {
      L.push('BEGIN:VALARM');
      L.push('ACTION:DISPLAY');
      L.push('DESCRIPTION:' + icsEsc(summary));
      L.push('TRIGGER:' + triggerStr(remind));
      L.push('END:VALARM');
    }

    L.push('END:VEVENT');
    count += eff.kept.length;
  }

  L.push('END:VCALENDAR');
  return { ics: L.map(foldLine).join('\r\n') + '\r\n', skipped, count };
}

/* =========================================================
   13. 匯出區
   ========================================================= */
function renderOutput() {
  const anchor = anchorMonday();
  const box = $('#summary');
  if (!box) return;

  if (!state.courses.length) {
    box.innerHTML = '<div class="srow"><span class="st">還沒有課程。回到第 2 區新增，或按「載入我的課表示例」。</span></div>';
    setHTML('#importHint', '');
    setHTML('#exportInfo', '');
    return;
  }
  if (!anchor || !state.semester.end) {
    box.innerHTML = '<div class="srow"><span class="st">請先在第 3 區設定學期開始與結束日期。</span></div>';
    return;
  }

  const built = buildICS();
  let rows = '';
  const sorted = state.courses.slice().sort((a, b) => blockDay(a) - blockDay(b) || a.start - b.start);
  for (const c of sorted) {
    const eff = effectiveDates(c);
    const fd = firstDateOf(c);
    const wn = weekNoOf(fd);
    const freq = c.kind === 'event'
      ? '單次·' + (c.date || '未定')
      : (c.freq === 'biweekly' ? '兩週一次' : '每週') + (wn >= 1 ? `·第${wn}週起` : '');
    const remind = c.remind === null ? state.settings.remindMin : c.remind;
    rows += `<div class="srow">
      <span class="sc">${esc(c.code || '—')}</span>
      <span class="st">${esc(c.title || '（未命名）')}
        <br><span style="color:#6e6e73;font-size:11.5px">${DAY_ZH[blockDay(c)]} ${fmtMin(c.start)}–${fmtMin(c.end)}
        ${c.room ? ' · Room ' + esc(c.room) : ''}${c.lecturer ? ' · ' + esc(c.lecturer) : ''}
        ${c.kind !== 'event' && fd ? ' · 第一堂 ' + fd : ''}</span></span>
      <span class="sm">${freq}<br>${eff.kept.length} 次${eff.excl.length ? '（跳過 ' + eff.excl.length + '）' : ''}
        <br>${remind > 0 ? '提醒 ' + remind + ' 分前' : '不提醒'}</span>
    </div>`;
  }
  box.innerHTML = rows;

  let html = `<div class="ok">將產生 <b>${built.count}</b> 個行程${
    built.skipped.length ? `，另有 ${built.skipped.length} 項在學期範圍內沒有課堂（已略過）` : ''}。
    提醒：${state.settings.remindMin > 0 ? '預設 ' + state.settings.remindMin + ' 分鐘前' : '預設不提醒'}${
    state.settings.futureOnly ? '　·　已開啟「只匯入今天以後」' : ''}</div>`;

  if (state.lastExport) {
    const t = new Date(state.lastExport.at);
    const when = `${t.getFullYear()}-${pad2(t.getMonth() + 1)}-${pad2(t.getDate())} ${pad2(t.getHours())}:${pad2(t.getMinutes())}`;
    html += (state.lastExport.fp === hashStr(built.ics))
      ? `<div class="warn blue">上次匯出：<b>${when}</b>。內容與當時完全相同 —— 若已匯入就不必再做一次。</div>`
      : `<div class="warn">上次匯出：<b>${when}</b>，內容已改變。重新匯入前建議先刪掉舊的「我的課表」行事曆（見下方步驟）。</div>`;
  }
  setHTML('#exportInfo', html);

  setHTML('#importHint', state.settings.futureOnly
    ? 'iPhone／iPad：按「下載 .ics 檔」後點一下檔案，系統會問要不要加入行事曆；或直接按「直接加入行事曆」。'
    : '⚠️ 「只匯入今天以後」已關閉，整學期（含已過去的）都會匯入，較容易和舊資料重疊。');
}

function downloadICS(ics) {
  const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'my-timetable.ics';
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 5000);
}

function openCalendar(ics) {
  const ua = navigator.userAgent || '';
  const isIOS = /iPad|iPhone|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
  if (isIOS) {
    window.location.href = 'data:text/calendar;charset=utf-8,' + encodeURIComponent(ics);
  } else {
    downloadICS(ics);
    setHTML('#importHint', '已下載 <b>my-timetable.ics</b>，雙擊它即可加入 Mac 行事曆。');
  }
}

function markExported(ics) {
  state.exportSeq = (state.exportSeq || 0) + 1;
  state.lastExport = { at: new Date().toISOString(), fp: hashStr(ics) };
  save();
  renderOutput();
}

/* =========================================================
   14. 列印
   ========================================================= */
let printing = false;
function doPrint() {
  if (printing) return;
  printing = true;
  renderPrintSub();
  const oldPPM = PPM;
  PPM = 0.62;
  renderGrid();
  document.body.classList.add('printing');

  let restored = false;
  const restore = () => {
    if (restored) return;
    restored = true;
    printing = false;
    document.body.classList.remove('printing');
    PPM = oldPPM;
    renderGrid();
    window.removeEventListener('afterprint', restore);
  };
  window.addEventListener('afterprint', restore);
  setTimeout(() => {
    try { window.print(); } catch (e) { restore(); }
    setTimeout(restore, 1500);
  }, 80);
}

/* =========================================================
   15. 初始化
   ========================================================= */
function renderAll() {
  renderHead();
  renderGrid();
  renderEditor();
  renderSemesterInfo();
  renderHolidays();
  renderOutput();
  renderPrintSub();
}

function bindTop() {
  $$('.stepper button').forEach(b => {
    b.addEventListener('click', () => {
      const el = document.getElementById(b.getAttribute('data-goto'));
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  const dz = $('#dz'), fileInput = $('#file');
  const pick = () => { if (fileInput) fileInput.click(); };
  if (dz) {
    dz.addEventListener('click', pick);
    dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('over'); });
    dz.addEventListener('dragleave', () => dz.classList.remove('over'));
    dz.addEventListener('drop', e => {
      e.preventDefault(); dz.classList.remove('over');
      const f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
      if (f) handleFile(f);
    });
  }
  if (fileInput) {
    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files[0]) handleFile(fileInput.files[0]);
      fileInput.value = '';
    });
  }

  document.addEventListener('paste', e => {
    const items = (e.clipboardData && e.clipboardData.items) || [];
    for (const it of items) {
      if (it.type && it.type.indexOf('image') === 0) {
        const f = it.getAsFile();
        if (f) { handleFile(f); return; }
      }
    }
  });

  on('#btnDemo', 'click', () => {
    state.courses = DEMO.map(d => mkCourse({
      code: d.code, title: d.title, lecturer: d.lecturer, room: d.room,
      day: d.day, start: minOf(d.start), end: minOf(d.end)
    }));
    state.selected = null;
    renderAll(); save();
    showProg(true);
    if ($('#progLog')) $('#progLog').textContent = '已載入示範資料（Fall 2026 課表）。請在第 2 區核對。';
    const s2 = $('#step2');
    if (s2) s2.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  on('#btnPaste', 'click', () => { const b = $('#pasteBox'); if (b) b.classList.toggle('hidden'); });

  on('#btnParseText', 'click', () => {
    const list = parsePlainText($('#pasteText') ? $('#pasteText').value : '');
    showProg(true);
    if ($('#progLog')) $('#progLog').textContent = '';
    logLine('解析文字：找到 ' + list.length + ' 行課程');
    finishParse(list);
  });

  on('#btnAdd', 'click', () => {
    const c = mkCourse({ kind: 'class', title: '新課程', day: 0, start: 540, end: 630 });
    state.courses.push(c);
    state.selected = c.id;
    renderAll(); save();
    scrollToEditor();
  });

  on('#btnAddEvent', 'click', () => {
    const c = mkCourse({ kind: 'event', title: '考試／行程', date: todayYmd(), start: 600, end: 660 });
    state.courses.push(c);
    state.selected = c.id;
    renderAll(); save();
    scrollToEditor();
  });

  on('#btnPrint', 'click', doPrint);

  on('#btnClear', 'click', () => {
    if (!state.courses.length) return;
    if (!confirm('確定清空所有課程與行程？')) return;
    state.courses = [];
    state.selected = null;
    renderAll(); save();
  });

  on('#btnDownload', 'click', () => {
    const built = buildICS();
    if (!built.count) { alert('目前沒有可匯出的行程，請先檢查學期日期與課程。'); return; }
    downloadICS(built.ics);
    markExported(built.ics);
    if (built.skipped.length) {
      setHTML('#importHint', '⚠️ 有 ' + built.skipped.length + ' 項沒有產生行程（超出學期範圍，或已被全部停課）。');
    }
  });

  on('#btnAddCal', 'click', () => {
    const built = buildICS();
    if (!built.count) { alert('目前沒有可匯出的行程，請先檢查學期日期與課程。'); return; }
    openCalendar(built.ics);
    markExported(built.ics);
  });

  on('#btnIcsText', 'click', () => {
    const pre = $('#icsPreview');
    if (!pre) return;
    pre.textContent = buildICS().ics;
    pre.classList.toggle('hidden');
  });
}

function scrollToEditor() {
  const ed = $('#editor');
  if (ed) ed.scrollIntoView({ behavior: 'smooth', block: 'center' });
  setTimeout(() => { const t = $('#eTitle'); if (t) t.focus(); }, 250);
}

function init() {
  try {
    const mon = mondayOfYmd(ymdOf(new Date()));
    state.semester.start = addDaysYmd(mon, -56);
    state.semester.end = addDaysYmd(state.semester.start, 104);

    restore();

    if (!parseYMD(state.semester.start)) {
      state.semester.start = addDaysYmd(mon, -56);
      state.semester.end = addDaysYmd(state.semester.start, 104);
    }

    setVal('#sStart', state.semester.start);
    setVal('#sEnd', state.semester.end);
    setVal('#sTz', state.semester.tz);
    setVal('#sRemind', String(state.settings.remindMin));
    const fo = $('#futureOnly');
    if (fo) fo.checked = !!state.settings.futureOnly;

    bindTop();
    bindEditor();
    bindSemester();

    renderAll();

    const tag = $('#readyTag');
    if (tag) tag.classList.remove('hidden');

    if (!state.holidays.length) setTimeout(() => loadHKHolidays(false), 800);
  } catch (err) {
    console.error(err);
    showFatal(err && err.message ? err.message : String(err));
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}
</script>
