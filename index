/* =========================================================
   1. 工具
   ========================================================= */
const pad2 = n => String(n).padStart(2, '0');
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const DAY_ZH = ['週一', '週二', '週三', '週四', '週五', '週六', '週日'];
const DAY_ABBR = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

function parseYMD(s) {
  const p = String(s || '').split('-');
  const y = Number(p[0]), m = Number(p[1]), d = Number(p[2]);
  if (!y || !m || !d) return null;
  return { y, m, d };
}
function ymdOf(d) { return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`; }
function todayYmd() { return ymdOf(new Date()); }
function addDaysYmd(s, n) {
  const p = parseYMD(s);
  if (!p) return '';
  const t = new Date(Date.UTC(p.y, p.m - 1, p.d + n));
  return `${t.getUTCFullYear()}-${pad2(t.getUTCMonth() + 1)}-${pad2(t.getUTCDate())}`;
}
function mondayOfYmd(s) {
  const p = parseYMD(s);
  if (!p) return '';
  const wd = (new Date(Date.UTC(p.y, p.m - 1, p.d)).getUTCDay() + 6) % 7;
  return addDaysYmd(s, -wd);
}
function dowMonOfYmd(s) {
  const p = parseYMD(s);
  if (!p) return 0;
  return (new Date(Date.UTC(p.y, p.m - 1, p.d)).getUTCDay() + 6) % 7;
}
function daysBetweenYmd(a, b) {
  const A = parseYMD(a), B = parseYMD(b);
  if (!A || !B) return 0;
  return Math.round((Date.UTC(B.y, B.m - 1, B.d) - Date.UTC(A.y, A.m - 1, A.d)) / 86400000);
}
function fmtMin(m) { m = ((m % 1440) + 1440) % 1440; return `${pad2(Math.floor(m / 60))}:${pad2(m % 60)}`; }
function minOf(hhmm) { const [h, m] = String(hhmm || '').split(':').map(Number); return (h || 0) * 60 + (m || 0); }
function hashStr(s) { let h = 0; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0; return String(h); }

function loadScript(urls) {
  urls = Array.isArray(urls) ? urls : [urls];
  let i = 0;
  const tryNext = () => new Promise((res, rej) => {
    if (i >= urls.length) return rej(new Error('所有 CDN 都載入失敗'));
    const s = document.createElement('script');
    s.src = urls[i++];
    s.onload = () => res(true);
    s.onerror = () => tryNext().then(res).catch(rej);
    document.head.appendChild(s);
  });
  return tryNext();
}

function fetchTimeout(url, ms) {
  return new Promise((resolve, reject) => {
    let done = false;
    const ctl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
    const timer = setTimeout(() => {
      if (done) return;
      done = true;
      if (ctl) { try { ctl.abort(); } catch (e) {} }
      reject(new Error('連線逾時'));
    }, ms || 7000);
    fetch(url, ctl ? { signal: ctl.signal, cache: 'no-cache' } : { cache: 'no-cache' })
      .then(r => { if (done) return; done = true; clearTimeout(timer); resolve(r); })
      .catch(e => { if (done) return; done = true; clearTimeout(timer); reject(e); });
  });
}

