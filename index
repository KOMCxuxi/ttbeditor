function buildWeekOptions(current) {
  const maxW = Math.max(24, weeksCount() + 4);
  let opts = '<option value="">—</option>';
  for (let i = 1; i <= maxW; i++) opts += `<option value="${i}">第 ${i} 週</option>`;
  const sel = $('#eWeek');
  if (sel) {
    sel.innerHTML = opts;
    sel.value = (current >= 1 && current <= maxW) ? String(current) : '';
  }
}

function renderEditor() {
  const box = $('#editor');
  if (!box) return;
  const c = state.courses.find(x => x.id === state.selected);
  if (!c) { box.classList.add('hidden'); return; }
  box.classList.remove('hidden');

  const isEvent = c.kind === 'event';
  setText('#edKind', isEvent ? '單次行程' : '每週／隔週課程');
  setVal('#eCode', c.code);
  setVal('#eTitle', c.title);
  setVal('#eLect', c.lecturer);
  setVal('#eRoom', c.room);
  setVal('#eDay', String(c.day));
  setVal('#eDate', c.date || '');
  setVal('#eStart', fmtMin(c.start));
  setVal('#eEnd', fmtMin(c.end));
  setVal('#eFreq', c.freq);
  setVal('#eRemind', c.remind === null ? '' : String(c.remind));

  const fd = firstDateOf(c);
  setVal('#eFirst', fd || '');
  buildWeekOptions(weekNoOf(fd));

  show('#wDay', !isEvent);
  show('#wDate', isEvent);
  show('#wFreq', !isEvent);
  show('#wFirst', !isEvent);
  show('#wWeek', !isEvent);
  show('#eSkipWrap', !isEvent);

  if (!isEvent) renderEditorSkip();
  renderFirstInfo(c);
}

function renderFirstInfo(c) {
  const box = $('#eFirstInfo');
  if (!box || !c) return;
  if (c.kind === 'event') {
    box.textContent = '單次行程：' + (c.date || '（尚未設定日期）');
    return;
  }
  const a = anchorMonday();
  if (!a) { box.textContent = '尚未設定學期日期，無法推算第一堂。'; return; }

  const fd = firstDateOf(c);
  const wn = weekNoOf(fd);
  const r = effectiveDates(c);
  const freqTxt = c.freq === 'biweekly' ? '兩週一次' : '每週一次';

  let txt = `${freqTxt} · 第一堂：<b>${fd}</b>（${DAY_ZH[dowMonOfYmd(fd)]}）`;
  txt += wn >= 1 ? `· 學期<b>第 ${wn} 週</b>` : '（早於學期開始）';
  txt += ` · 共 <b>${r.kept.length}</b> 次`;
  if (r.excl.length) txt += ` · 已跳過 ${r.excl.length} 次（停課日）`;
  if (state.settings.futureOnly) txt += ' · 匯出時只保留今天之後';
  box.innerHTML = txt;
}

function renderEditorSkip() {
  const c = state.courses.find(x => x.id === state.selected);
  const box = $('#eSkipChips');
  if (!c || !box) return;
  const list = (c.skip || []).slice().sort();
  if (!list.length) {
    box.innerHTML = '<span class="hint" style="margin:0">沒有額外停課日</span>';
    return;
  }
  box.innerHTML = list.map(d => `
    <span class="chip mini off" style="opacity:1">
      <b style="text-decoration:line-through">${d}</b>
      <span class="x" data-skipdel="${d}">×</span>
    </span>`).join('');
  box.querySelectorAll('[data-skipdel]').forEach(x => {
    x.addEventListener('click', () => {
      const d = x.getAttribute('data-skipdel');
      c.skip = c.skip.filter(v => v !== d);
      renderEditorSkip(); renderFirstInfo(c); renderOutput(); save();
    });
  });
}

function bindEditor() {
  const upd = fn => () => {
    const c = state.courses.find(x => x.id === state.selected);
    if (!c) return;
    fn(c);
    renderGrid();
    renderSemesterInfo();
    renderOutput();
    renderFirstInfo(c);
    save();
  };

  on('#eCode', 'input', upd(c => c.code = $('#eCode').value.trim()));
  on('#eTitle', 'input', upd(c => c.title = $('#eTitle').value.trim()));
  on('#eLect', 'input', upd(c => c.lecturer = $('#eLect').value.trim()));
  on('#eRoom', 'input', upd(c => c.room = $('#eRoom').value.trim()));

  /* 換星期：第一堂日期跟著平移，週數不變 */
  on('#eDay', 'change', () => {
    const c = state.courses.find(x => x.id === state.selected);
    if (!c) return;
    const nd = +$('#eDay').value;
    const od = blockDay(c);
    if (parseYMD(c.firstDate)) c.firstDate = addDaysYmd(c.firstDate, nd - od);
    c.day = nd;
    renderGrid(); renderSemesterInfo(); renderOutput();
    setVal('#eFirst', firstDateOf(c));
    buildWeekOptions(weekNoOf(firstDateOf(c)));
    renderFirstInfo(c); save();
  });

  on('#eDate', 'change', upd(c => c.date = $('#eDate').value));

  /* 第一堂日期：直接決定這門課從哪天開始 */
  on('#eFirst', 'change', () => {
    const c = state.courses.find(x => x.id === state.selected);
    if (!c) return;
    const v = $('#eFirst').value;
    if (parseYMD(v)) {
      c.firstDate = v;
      c.day = dowMonOfYmd(v);
      setVal('#eDay', String(c.day));
    } else {
      c.firstDate = '';
    }
    renderGrid(); renderSemesterInfo(); renderOutput();
    buildWeekOptions(weekNoOf(c.firstDate));
    renderFirstInfo(c); save();
  });

  /* 用「學期第幾週」快速設定第一堂 */
  on('#eWeek', 'change', () => {
    const c = state.courses.find(x => x.id === state.selected);
    if (!c) return;
    const n = +$('#eWeek').value;
    const a = anchorMonday();
    if (!a || !n) { c.firstDate = ''; }
    else {
      c.firstDate = addDaysYmd(a, (n - 1) * 7 + c.day);
      setVal('#eFirst', c.firstDate);
    }
    renderGrid(); renderSemesterInfo(); renderOutput();
    renderFirstInfo(c); save();
  });

  on('#eStart', 'change', upd(c => {
    c.start = minOf($('#eStart').value);
    if (c.end <= c.start) c.end = Math.min(DAY_END, c.start + 50);
  }));
  on('#eEnd', 'change', upd(c => {
    c.end = minOf($('#eEnd').value);
    if (c.end <= c.start) c.end = Math.min(DAY_END, c.start + 50);
  }));
  on('#eFreq', 'change', upd(c => c.freq = $('#eFreq').value));
  on('#eRemind', 'change', upd(c => {
    c.remind = $('#eRemind').value === '' ? null : +$('#eRemind').value;
  }));

  on('#eAddSkip', 'click', () => {
    const c = state.courses.find(x => x.id === state.selected);
    const d = $('#eSkipDate') ? $('#eSkipDate').value : '';
    if (!c || !d) return;
    if (c.skip.indexOf(d) < 0) c.skip.push(d);
    $('#eSkipDate').value = '';
    renderEditorSkip(); renderFirstInfo(c); renderOutput(); save();
  });

  on('#eDel', 'click', () => {
    state.courses = state.courses.filter(x => x.id !== state.selected);
    state.selected = null;
    renderAll(); save();
  });
  on('#eClose', 'click', () => { state.selected = null; renderAll(); });
  on('#ePrint', 'click', doPrint);
}

/* =========================================================
   11. 學期
   ========================================================= */
function renderSemesterInfo() {
  const a = anchorMonday();
  const w = weeksCount();
  if (!a) { setHTML('#semInfo', '請填寫學期開始日。'); setHTML('#semWarn', ''); return; }

  let total = 0, skippedEx = 0;
  state.courses.forEach(c => {
    const r = effectiveDates(c);
    total += r.kept.length;
    skippedEx += r.excl.length;
  });
  const holidayOn = (state.holidays || []).filter(h => h.off).length;

  setHTML('#semInfo',
    `第一週：<b>${a}（週一）</b>　·　共 <b>${w}</b> 週　·　最後一週：<b>${w ? addDaysYmd(a, (w - 1) * 7) : '—'}</b><br>
     課程／行程 <b>${state.courses.length}</b> 項　·　實際會產生 <b>${total}</b> 個行程
     ${skippedEx ? '　·　因停課跳過 <b>' + skippedEx + '</b> 次' : ''}
     ${holidayOn ? '　·　停課日 <b>' + holidayOn + '</b> 天' : ''}`);

  const msgs = [];
  if (mondayOfYmd(state.semester.start) !== state.semester.start)
    msgs.push('開始日不是星期一，已自動對齊到該週的 <b>' + a + '</b>。');
  if (w <= 0) msgs.push('結束日早於開始日，請重新設定。');

  const bad = state.courses.filter(c => c.end <= c.start);
  if (bad.length) msgs.push('有 ' + bad.length + ' 項的結束時間早於開始時間。');

  const noDate = state.courses.filter(c => c.kind === 'event' && !c.date);
  if (noDate.length) msgs.push('有 ' + noDate.length + ' 個單次行程還沒設定日期。');

  const outRange = state.courses.filter(c => c.kind === 'event' && c.date && !courseDates(c, a, state.semester.end).length);
  if (outRange.length) msgs.push('有 ' + outRange.length + ' 個單次行程的日期不在學期範圍內，不會被匯出。');

  const lateStart = state.courses.filter(c => c.kind !== 'event' && weekNoOf(firstDateOf(c)) > 1);
  if (lateStart.length) {
    msgs.push('有 ' + lateStart.length + ' 門課不是從第 1 週開始（格子上有橙色左邊條），請確認是否正確。');
  }

  for (let d = 0; d < 7 && msgs.length < 4; d++) {
    const list = state.courses.filter(c => blockDay(c) === d).sort((x, y) => x.start - y.start);
    outer:
    for (let i = 0; i < list.length; i++) {
      for (let j = i + 1; j < list.length; j++) {
        if (list[j].start < list[i].end) {
          msgs.push(`時間衝突：${DAY_ZH[d]}「${list[i].code || list[i].title}」與「${list[j].code || list[j].title}」重疊。`);
          break outer;
        }
      }
    }
  }
  setHTML('#semWarn', msgs.length ? '<div class="warn">' + msgs.slice(0, 5).join('<br>') + '</div>' : '');
}

